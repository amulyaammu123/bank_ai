# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The REST API URL of your Supabase project (Vite-prefixed for client access)
VITE_SUPABASE_URL=https://placeholder.supabase.co

# SUPABASE_ANON_KEY: The anonymous/public API key of your Supabase project (Vite-prefixed)
VITE_SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY
