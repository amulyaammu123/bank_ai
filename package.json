{
  "name": "safebank-ai-appium",
  "version": "1.0.0",
  "description": "Appium E2E Automation Framework for SafeBank Android App",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.test.js --timeout 180000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mochawesome-report,html=true,json=true",
    "test:auth": "mocha tests/auth.test.js --timeout 180000 --reporter mochawesome",
    "test:validation": "mocha tests/formValidation.test.js --timeout 180000 --reporter mochawesome",
    "test:gestures": "mocha tests/gestures.test.js --timeout 180000 --reporter mochawesome",
    "test:e2e": "mocha tests/e2eFlow.test.js --timeout 180000 --reporter mochawesome",
    "test:call": "mocha tests/call.test.js --timeout 180000 --reporter mochawesome",
    "test:sms": "mocha tests/sms.test.js --timeout 180000 --reporter mochawesome",
    "test:chatbot": "mocha tests/chatbot.test.js --timeout 180000 --reporter mochawesome",
    "test:sos": "mocha tests/sos.test.js --timeout 180000 --reporter mochawesome",
    "test:settings": "mocha tests/settings.test.js --timeout 180000 --reporter mochawesome",
    "test:admin": "mocha tests/admin.test.js --timeout 180000 --reporter mochawesome"
  },
  "dependencies": {
    "appium": "^2.11.3",
    "appium-uiautomator2-driver": "^3.7.8",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "webdriverio": "^8.40.0",
    "winston": "^3.13.0"
  }
}
